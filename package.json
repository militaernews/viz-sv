{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "2.0.2",
		"@eslint/js": "10.0.1",
		"@iconify-json/bi": "1.2.7",
		"@iconify-json/flat-color-icons": "1.2.3",
		"@iconify-json/fluent": "1.2.39",
		"@iconify-json/fluent-color": "1.2.21",
		"@iconify-json/fluent-emoji": "1.2.7",
		"@iconify-json/logos": "1.2.10",
		"@iconify-json/material-symbols": "1.2.57",
		"@iconify-json/mdi": "1.2.3",
		"@sveltejs/kit": "2.53.0",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/vite": "4.2.1",
		"@vite-pwa/sveltekit": "1.1.0",
		"daisyui": "5.5.19",
		"eslint": "10.0.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.15.0",
		"globals": "17.3.0",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "3.5.0",
		"prettier-plugin-tailwindcss": "0.7.2",
		"svelte": "5.53.3",
		"svelte-check": "4.4.3",
		"tailwindcss": "4.2.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.56.0",
		"unplugin-icons": "23.0.1",
		"vite": "7.3.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@iconify/svelte": "5.2.1",
		"sveltekit-superforms": "2.30.0",
		"valibot": "1.2.0",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.19",
		"@boxfish-studio/sveltekit-cookie-manager": "1.0.3"
